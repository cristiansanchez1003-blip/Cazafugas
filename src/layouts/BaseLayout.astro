---
import '@styles/global.css';
import { BUSINESS } from '@config/business';
import { GTM_ID } from '@config/analytics';
import { getImage } from 'astro:assets';
import logoSrc from '../assets/logo-mister-gas.png';

interface Props {
  title: string;
  description: string;
  /** Ruta absoluta o relativa a la raíz. 1200 × 630. */
  image?: string;
}

const { title, description, image = '/og.jpg' } = Astro.props;
const site = Astro.site ?? new URL(BUSINESS.domain);
const canonical = new URL(Astro.url.pathname, site).href;
const imageUrl = new URL(image, site).href;
const imageAlt = `${BUSINESS.name}: servicio integral de gasfitería`;

// JSON-LD del negocio (completar los TODO de business.ts antes de publicar).
const schemaLogo = await getImage({ src: logoSrc, width: 400, format: 'webp', quality: 80 });
const businessJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Plumber',
  '@id': `${BUSINESS.domain}/#negocio`,
  name: BUSINESS.name,
  url: `${BUSINESS.domain}/`,
  logo: new URL(schemaLogo.src, site).href,
  image: new URL('/og.jpg', site).href,
  telephone: BUSINESS.phoneE164,
  areaServed: [
    ...BUSINESS.communes.map((name) => ({ '@type': 'City', name })),
    { '@type': 'AdministrativeArea', name: BUSINESS.region },
  ],
  openingHoursSpecification: [
    {
      '@type': 'OpeningHoursSpecification',
      dayOfWeek: ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday'],
      opens: BUSINESS.hours.open,
      closes: BUSINESS.hours.close,
    },
  ],
  paymentAccepted: BUSINESS.paymentAccepted,
  hasCredential: {
    '@type': 'EducationalOccupationalCredential',
    credentialCategory: 'Licencia',
    name: BUSINESS.gasLicense,
    recognizedBy: {
      '@type': 'GovernmentOrganization',
      name: 'Superintendencia de Electricidad y Combustibles (SEC)',
    },
  },
  hasOfferCatalog: {
    '@type': 'OfferCatalog',
    name: 'Servicio integral de gasfitería',
    itemListElement: BUSINESS.services.map((service) => ({
      '@type': 'Offer',
      itemOffered: { '@type': 'Service', name: service.name },
    })),
  },
  ...(BUSINESS.sameAs.length > 0 ? { sameAs: BUSINESS.sameAs } : {}),
};
---

<!doctype html>
<html lang="es-CL">
  <head>
    <meta charset="UTF-8" />
    <script is:inline>
      // Las animaciones de data-reveal solo aplican con .js (ver global.css).
      document.documentElement.classList.add('js');
    </script>
    <script is:inline>
      // Capa de datos: clics en tel: y wa.me. Cada enlace lleva data-cta
      // (header, hero, barra_movil, modal, contacto, footer) y los del modal data-service.
      window.dataLayer = window.dataLayer || [];
      document.addEventListener('click', (e) => {
        const a = e.target.closest && e.target.closest('a[href^="tel:"], a[href*="wa.me/"]');
        if (!a) return;
        const isTel = a.href.startsWith('tel:');
        window.dataLayer.push({
          event: isTel ? 'tel_click' : 'whatsapp_click',
          cta_location: a.dataset.cta || 'sin_definir',
          service: a.dataset.service || undefined,
        });
      });
    </script>
    {
      GTM_ID && (
        <script is:inline define:vars={{ GTM_ID }}>
          // GTM (GA4) solo en mistergas.cl: localhost y las vistas previas de Vercel no ensucian
          // los datos. Se carga cuando la página terminó de cargar, para no competir con el
          // contenido visible (Fase 4, velocidad en celular). Los eventos que se empujen antes
          // quedan en dataLayer y GTM los procesa al llegar.
          (function (w, d, i) {
            if (location.hostname.replace(/^www\./, '') !== 'mistergas.cl') return;
            w.dataLayer = w.dataLayer || [];
            w.dataLayer.push({ 'gtm.start': new Date().getTime(), event: 'gtm.js' });
            function load() {
              var j = d.createElement('script');
              j.async = true;
              j.src = 'https://www.googletagmanager.com/gtm.js?id=' + i;
              d.head.appendChild(j);
            }
            function later() {
              if ('requestIdleCallback' in w) w.requestIdleCallback(load, { timeout: 2500 });
              else setTimeout(load, 1200);
            }
            if (d.readyState === 'complete') later();
            else w.addEventListener('load', later, { once: true });
          })(window, document, GTM_ID);
        </script>
      )
    }
    <meta name="description" content={description} />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <meta name="theme-color" content="#00236f" />
    <link rel="icon" href="/favicon.ico" sizes="48x48" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <!-- Fuentes propias (ver global.css). Outfit va en el H1, que es el elemento LCP. -->
    <link rel="preload" href="/fonts/outfit-latin.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/inter-latin.woff2" as="font" type="font/woff2" crossorigin />
    <title>{title}</title>
    <link rel="canonical" href={canonical} />

    <meta property="og:type" content="website" />
    <meta property="og:locale" content="es_CL" />
    <meta property="og:site_name" content={BUSINESS.name} />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={imageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={imageAlt} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={imageUrl} />
    <meta name="twitter:image:alt" content={imageAlt} />

    <script type="application/ld+json" set:html={JSON.stringify(businessJsonLd)} />
    <slot name="head" />
  </head>
  <body>
    {
      GTM_ID && (
        <noscript>
          <iframe
            src={`https://www.googletagmanager.com/ns.html?id=${GTM_ID}`}
            height="0"
            width="0"
            style="display:none;visibility:hidden"
          ></iframe>
        </noscript>
      )
    }
    <slot />
    <script is:inline>
      const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

      const header = document.querySelector('[data-site-header]');
      const syncHeader = () => {
        if (!header) return;
        const isScrolled = window.scrollY > 8;
        const nav = header.querySelector('nav');
        header.classList.toggle('bg-white/80', isScrolled);
        header.classList.toggle('backdrop-blur-md', isScrolled);
        header.classList.toggle('shadow-sm', isScrolled);
        header.classList.toggle('border-slate-200/70', isScrolled);
        header.classList.toggle('bg-transparent', !isScrolled);
        header.classList.toggle('border-transparent', !isScrolled);
        nav?.classList.toggle('text-slate-600', isScrolled);
        nav?.classList.toggle('text-white', !isScrolled);
      };

      syncHeader();
      window.addEventListener('scroll', syncHeader, { passive: true });

      if (!prefersReducedMotion && 'IntersectionObserver' in window) {
        const revealObserver = new IntersectionObserver(
          (entries) => {
            entries.forEach((entry) => {
              if (!entry.isIntersecting) return;
              entry.target.classList.add('is-visible');
              revealObserver.unobserve(entry.target);
            });
          },
          { rootMargin: '0px 0px -12% 0px', threshold: 0.12 }
        );

        document.querySelectorAll('[data-reveal]').forEach((element, index) => {
          element.style.setProperty('--reveal-delay', `${Math.min(index % 6, 5) * 90}ms`);
          revealObserver.observe(element);
        });

        const heroVisual = document.querySelector('[data-hero-parallax]');
        const syncParallax = () => {
          if (!heroVisual) return;
          const y = Math.min(window.scrollY * 0.14, 64);
          heroVisual.style.setProperty('--parallax-y', `${y}px`);
        };

        syncParallax();
        window.addEventListener('scroll', syncParallax, { passive: true });
      } else {
        document.querySelectorAll('[data-reveal]').forEach((element) => {
          element.classList.add('is-visible');
        });
      }
    </script>
  </body>
</html>
