---
import BaseLayout from '@layouts/BaseLayout.astro';
import Header from '@components/Header.astro';
import Hero from '@components/Hero.astro';
import ContactForm from '@components/ContactForm.astro';
import Services from '@components/Services.astro';
import TrustBand from '@components/TrustBand.astro';
import FAQ from '@components/FAQ.astro';
import Footer from '@components/Footer.astro';
import { communesText } from '@config/business';

export const prerender = true;
---

<BaseLayout
  title="Cazafugas | Detección de Fugas y Gasfitería Certificada"
  description={`Servicio profesional de detección de fugas, gasfitería y reparaciones certificadas en ${communesText()}.`}
>
  <Header />
  <main>
    <Hero />
    <ContactForm />
    <Services />
    <TrustBand />
    <FAQ />
  </main>
  <Footer />
</BaseLayout>
