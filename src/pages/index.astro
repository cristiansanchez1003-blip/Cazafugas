---
import BaseLayout from '@layouts/BaseLayout.astro';
import Header from '@components/Header.astro';
import Hero from '@components/Hero.astro';
import ContactForm from '@components/ContactForm.astro';
import Services from '@components/Services.astro';
import TrustBand from '@components/TrustBand.astro';
import FAQ from '@components/FAQ.astro';
import HowWeWork from '@components/HowWeWork.astro';
import Communes from '@components/Communes.astro';
import Reviews from '@components/Reviews.astro';
import Cases from '@components/Cases.astro';
import Footer from '@components/Footer.astro';
import MobileCtaBar from '@components/MobileCtaBar.astro';
import { BUSINESS, communesText } from '@config/business';
import { faqJsonLd } from '../data/faq';

export const prerender = true;

const title = `Detección de Fugas y Gasfiter en Puente Alto y La Florida | ${BUSINESS.name}`;
const description = `Detección de fugas sin romper, gasfitería y calefones en ${communesText()}. Técnico SEC. Lunes a viernes de 9 a 18.`;
---

<BaseLayout title={title} description={description}>
  <script slot="head" type="application/ld+json" set:html={JSON.stringify(faqJsonLd())} />
  <Header />
  <main>
    <!-- Orden de secciones: PLAN-MAESTRO 2.5 -->
    <Hero />
    <TrustBand />
    <Reviews />
    <Services />
    <HowWeWork />
    <Cases />
    <Communes />
    <ContactForm />
    <FAQ />
  </main>
  <Footer />
  <MobileCtaBar />
</BaseLayout>
