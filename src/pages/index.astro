---
import BaseLayout from '@layouts/BaseLayout.astro';
import Header from '@components/Header.astro';
import Hero from '@components/Hero.astro';
import ContactForm from '@components/ContactForm.astro';
import Services from '@components/Services.astro';
import TrustBand from '@components/TrustBand.astro';
import FAQ from '@components/FAQ.astro';
import Footer from '@components/Footer.astro';

export const prerender = true;
---

<BaseLayout
  title="Cazafugas | Deteccion de Fugas y Gasfiteria Certificada"
  description="Servicio profesional de deteccion de fugas, gasfiteria y reparaciones certificadas en Puente Alto, La Florida, Macul y San Jose de Maipo."
>
  <Header />
  <main>
    <Hero />
    <ContactForm />
    <Services />
    <TrustBand />
    <FAQ />
  </main>
  <Footer />
</BaseLayout>
