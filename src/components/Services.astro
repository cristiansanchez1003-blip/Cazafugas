---
import { BUSINESS, waLink } from '@config/business';

const services = [
  {
    id: 'calefones',
    title: 'Mantención y Reparación de Calefones',
    short: 'Diagnostico y mantencion para agua caliente segura.',
    modalTitle: 'Calefones: Agua caliente sin interrupciones.',
    detail:
      '¿Tu calefón falla en el peor momento? Realizamos mantenimiento preventivo y reparación técnica certificada para equipos de todas las marcas. Aseguramos eficiencia energética y, sobre todo, máxima seguridad para tu familia.',
    cta: 'Agendar mantenimiento ahora',
    image: '/images/servicios/calefones.webp'
  },
  {
    id: 'fugas',
    title: 'Detección de Fugas de Agua y Gas',
    short: 'Localizacion precisa con tecnologia no invasiva.',
    modalTitle: 'Detección de fugas con tecnología ultrasónica.',
    detail:
      'No rompas paredes innecesariamente. Utilizamos equipos de termografía y ultrasonido para localizar el origen exacto de la filtración. Diagnóstico rápido, preciso y profesional para evitar daños mayores.',
    cta: 'Solicitar detección urgente',
    image: '/images/servicios/fugas.webp'
  },
  {
    id: 'redes',
    title: 'Redes de Agua Potable y Sanitarias',
    short: 'Soluciones para redes domiciliarias y comerciales.',
    modalTitle: 'Redes sanitarias seguras y certificadas.',
    detail:
      'Diseñamos e instalamos redes de agua potable y sanitarias bajo estrictas normas de ingeniería. Garantizamos estanqueidad, durabilidad y materiales de primera calidad para tu tranquilidad.',
    cta: 'Cotizar instalación',
    image: '/images/servicios/redes.webp'
  },
  {
    id: 'destapes',
    title: 'Destapes y Limpieza de Cañerías',
    short: 'Intervencion rapida para obstrucciones sanitarias.',
    modalTitle: 'Solución definitiva a bloqueos y atascos.',
    detail:
      'Recupera el flujo normal de tus instalaciones. Usamos maquinaria de alta presión para eliminar obstrucciones profundas en alcantarillados y redes sanitarias. Servicio limpio, rápido y efectivo.',
    cta: 'Solicitar destape',
    image: '/images/servicios/destapes.webp'
  },
  {
    id: 'griferia',
    title: 'Reparación de Grifería y Artefactos',
    short: 'Instalacion, cambio y reparacion de piezas sanitarias.',
    modalTitle: 'Grifería impecable, funcionamiento óptimo.',
    detail:
      '¿Goteos molestos o baja presión? Reparamos y renovamos grifería y artefactos sanitarios de alta gama. Devolvemos la estética y funcionalidad a tu baño o cocina con mano de obra experta.',
    cta: 'Reparar ahora',
    image: '/images/servicios/griferia.webp'
  }
];

// Datos del modal: se generan desde `services` para no duplicarlos en el script.
const servicesData = services.map((service) => ({
  id: service.id,
  title: service.modalTitle,
  detail: service.detail,
  cta: service.cta,
  waHref: waLink(`Hola ${BUSINESS.name}. Quiero cotizar el servicio: ${service.title}.`)
}));
---

<section id="servicios" class="w-full max-w-full overflow-x-hidden bg-slate-950 px-4 py-16 text-white sm:px-6 md:px-8 md:py-28">
  <div class="mx-auto max-w-7xl">
    <div data-reveal class="mx-auto max-w-2xl text-center">
      <p class="font-sans text-xs font-black uppercase tracking-[0.18em] text-cyan-300">Servicios tecnicos</p>
      <h2 class="mt-4 font-heading text-4xl font-extrabold leading-tight md:text-5xl">
        Soluciones Especializadas
      </h2>
      <p class="mt-4 font-sans text-base leading-relaxed text-gray-300">
        Atencion profesional para fugas, redes, calefones, destapes y griferia con enfoque rapido, limpio y certificado.
      </p>
    </div>

    <div class="mt-12 grid grid-cols-1 gap-5 md:grid-cols-2 md:gap-6 lg:grid-cols-3">
      {
        services.map((service) => (
          <article
            data-reveal
            class={`group relative min-h-[25rem] overflow-hidden rounded-3xl border bg-white/10 p-8 shadow-2xl backdrop-blur-lg transition-all duration-300 hover:-translate-y-1 hover:bg-white/20 focus-within:-translate-y-1 focus-within:bg-white/20 ${
              service.id === 'calefones'
                ? 'border-emerald-300/60 shadow-emerald-500/25 ring-2 ring-emerald-300/40 lg:scale-[1.03]'
                : 'border-white/20 shadow-black/20'
            }`}
          >
            <img
              src={service.image}
              alt=""
              class="absolute inset-0 -z-20 h-full w-full object-cover transition duration-500 group-hover:scale-105"
              loading="lazy"
              decoding="async"
            />
            <div class="absolute inset-0 -z-10 bg-black/60"></div>
            <div class="absolute inset-0 -z-10 bg-gradient-to-t from-slate-950 via-slate-950/45 to-transparent"></div>

            <div class="flex h-full flex-col justify-end">
              {
                service.id === 'calefones' && (
                  <span class="mb-5 inline-flex w-fit rounded-full border border-emerald-200/50 bg-emerald-400/20 px-4 py-2 font-sans text-xs font-black uppercase tracking-[0.14em] text-emerald-100 backdrop-blur-md">
                    Servicio destacado
                  </span>
                )
              }
              <img
                src="/assets/logotipo-cazafugas.png"
                alt=""
                class="mb-6 size-24 object-contain drop-shadow-lg"
                loading="lazy"
                decoding="async"
              />
              <h3 class="font-heading text-3xl font-extrabold leading-tight text-white">{service.title}</h3>
              <p class="mt-4 min-h-14 font-sans text-sm leading-relaxed text-gray-200">{service.short}</p>
              <button
                type="button"
                class="mt-7 inline-flex w-full items-center justify-center rounded-xl border border-white/30 bg-white/10 px-5 py-4 font-sans text-sm font-black uppercase text-white backdrop-blur-md transition hover:bg-white hover:text-slate-950 focus:outline-none focus:ring-2 focus:ring-cyan-300 sm:w-auto"
                data-service-trigger
                data-service-id={service.id}
              >
                Ver detalles
              </button>
            </div>
          </article>
        ))
      }
    </div>
  </div>

  <div
    data-service-modal
    class="fixed inset-0 z-[80] hidden items-center justify-center overflow-y-auto bg-black/50 px-4 py-8 backdrop-blur-sm"
    aria-hidden="true"
  >
    <div class="absolute inset-0" data-service-close></div>
    <div
      class="relative w-full max-w-lg rounded-3xl bg-white p-8 text-slate-950 shadow-2xl"
      role="dialog"
      aria-modal="true"
      aria-labelledby="service-modal-title"
    >
      <button
        type="button"
        class="absolute right-4 top-4 flex size-12 cursor-pointer items-center justify-center rounded-full bg-slate-100 text-3xl leading-none text-gray-800 transition hover:bg-slate-200 hover:text-slate-950 focus:outline-none focus:ring-2 focus:ring-blue-500"
        data-service-close
        aria-label="Cerrar modal"
      >
        ×
      </button>

      <p class="font-sans text-xs font-black uppercase tracking-[0.18em] text-blue-700">Detalle del servicio</p>
      <h3 id="service-modal-title" data-modal-title class="mt-4 pr-10 font-heading text-4xl font-extrabold leading-tight text-slate-950"></h3>
      <p data-modal-description class="mt-5 font-sans text-base leading-relaxed text-slate-600"></p>

      <a
        data-modal-whatsapp
        href="#contacto"
        class="mt-8 inline-flex min-h-14 w-full items-center justify-center rounded-xl bg-gradient-to-r from-green-500 to-emerald-600 px-6 py-4 font-sans text-sm font-black uppercase text-white shadow-lg shadow-emerald-500/30 transition hover:scale-[1.02] hover:from-green-400 hover:to-emerald-500 focus:outline-none focus:ring-2 focus:ring-emerald-500 focus:ring-offset-2 sm:w-auto"
      >
        Cotizar este servicio
      </a>
    </div>
  </div>
</section>

<script is:inline define:vars={{ servicesData }}>
  const modal = document.querySelector('[data-service-modal]');
  const modalTitle = document.querySelector('[data-modal-title]');
  const modalDescription = document.querySelector('[data-modal-description]');
  const modalWhatsapp = document.querySelector('[data-modal-whatsapp]');
  const triggers = document.querySelectorAll('[data-service-trigger]');
  const closeButtons = document.querySelectorAll('[data-service-close]');

  const openServiceModal = (serviceId) => {
    const service = servicesData.find((item) => item.id === serviceId);
    if (!service || !modal || !modalTitle || !modalDescription || !modalWhatsapp) return;

    modalTitle.textContent = service.title;
    modalDescription.textContent = service.detail;
    modalWhatsapp.textContent = service.cta;
    modalWhatsapp.href = service.waHref;

    modal.classList.remove('hidden');
    modal.classList.add('flex');
    modal.setAttribute('aria-hidden', 'false');
    document.documentElement.classList.add('overflow-hidden');
  };

  const closeServiceModal = () => {
    if (!modal) return;

    modal.classList.add('hidden');
    modal.classList.remove('flex');
    modal.setAttribute('aria-hidden', 'true');
    document.documentElement.classList.remove('overflow-hidden');
  };

  triggers.forEach((trigger) => {
    trigger.addEventListener('click', () => openServiceModal(trigger.dataset.serviceId));
  });

  closeButtons.forEach((button) => {
    button.addEventListener('click', closeServiceModal);
  });

  document.addEventListener('keydown', (event) => {
    if (event.key === 'Escape') closeServiceModal();
  });
</script>
