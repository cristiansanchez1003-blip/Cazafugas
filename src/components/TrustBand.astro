---
const paymentMethods = [
  {
    label: 'Efectivo',
    image: '/assets/pago-efectivo.webp'
  },
  {
    label: 'Transferencia',
    image: '/assets/pago-transferencia.webp'
  },
  {
    label: 'Tarjetas',
    image: '/assets/pago-tarjetas.webp'
  }
];
---

<section id="certificaciones" class="w-full max-w-full overflow-x-hidden bg-brand-navy px-4 py-14 text-white sm:px-6 md:px-8 md:py-20">
  <div class="mx-auto max-w-7xl">
    <div
      data-reveal
      class="grid grid-cols-1 gap-5 rounded-3xl border border-white/10 bg-white/[0.03] p-4 shadow-2xl shadow-black/20 backdrop-blur-sm sm:p-6 md:grid-cols-[0.95fr_1.45fr] md:gap-6"
    >
      <div class="rounded-2xl border border-white/10 bg-white/5 p-4 sm:p-5">
        <div class="flex flex-col items-center gap-4 text-center sm:flex-row sm:text-left">
          <img
            src="/assets/certificacion-sec-title.png"
            alt="Personal certificado SEC"
            class="h-20 w-auto max-w-full rounded-full object-contain drop-shadow-lg sm:h-24"
            loading="lazy"
            decoding="async"
          />
          <div>
            <h2 class="font-heading text-2xl font-extrabold leading-tight text-white sm:text-3xl">
              Técnico Autorizado SEC
            </h2>
            <p class="mt-2 font-sans text-sm font-medium leading-relaxed text-blue-100">
              Garantía de cumplimiento normativo.
            </p>
            <p class="mt-3 font-sans text-xs font-bold uppercase tracking-[0.12em] text-cyan-200">
              Nº de Certificación: 000000
            </p>
          </div>
        </div>
      </div>

      <div class="grid grid-cols-1 gap-4">
        <div class="grid grid-cols-1 gap-3 sm:grid-cols-3">
          {
            paymentMethods.map((method) => (
              <div
                data-reveal
                class="flex flex-col items-center justify-center rounded-xl bg-white/5 p-4 text-center transition-all duration-300 hover:-translate-y-1 hover:bg-white/10"
              >
                <img
                  src={method.image}
                  alt={method.label}
                  class="h-10 w-auto max-w-full object-contain"
                  loading="lazy"
                  decoding="async"
                />
                <p class="mt-3 font-sans text-xs font-medium uppercase tracking-[0.14em] text-blue-100">
                  {method.label}
                </p>
              </div>
            ))
          }
        </div>

        <div class="rounded-2xl border border-emerald-300/30 bg-emerald-400/10 p-4 text-center sm:text-left">
          <p class="font-sans text-sm font-bold leading-relaxed text-emerald-50 sm:text-base">
            ✅ Pago 100% presencial al finalizar el trabajo. Sin anticipos ni transferencias previas.
          </p>
        </div>
      </div>
    </div>
  </div>
</section>
