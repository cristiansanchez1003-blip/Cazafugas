---
import { Image } from 'astro:assets';
import { BUSINESS, telLink } from '@config/business';
import logo from '../assets/logo-mister-gas.png';

const navItems = [
  { href: '/#servicios', label: 'Servicios' },
  { href: '/#comunas', label: 'Comunas' },
  { href: '/#certificaciones', label: 'Certificaciones' },
  { href: '/#preguntas', label: 'Preguntas' }
];
---

<header
  data-site-header
  class="glass-ready fixed inset-x-0 top-0 z-50 border-b border-transparent bg-transparent"
>
  <div class="mx-auto flex h-[var(--header-height)] max-w-7xl items-center justify-between px-5 md:px-8">
    <a href="/" class="flex items-center gap-3 py-3" aria-label={`Ir al inicio de ${BUSINESS.name}`}>
      <Image
        src={logo}
        alt={BUSINESS.name}
        class="h-16 w-auto object-contain drop-shadow-[0_12px_28px_rgba(0,0,0,0.28)]"
        width={115}
        height={128}
        format="webp"
        quality={75}
        loading="eager"
      />
    </a>

    <nav class="hidden items-center gap-10 text-[1.05rem] font-bold text-white md:flex" aria-label="Principal">
      {
        navItems.map((item) => (
          <a class="transition hover:text-brand-cyan focus:text-brand-cyan focus:outline-none" href={item.href}>
            {item.label}
          </a>
        ))
      }
    </nav>

    <a
      href={telLink()}
      data-cta="header"
      class="inline-flex items-center gap-3 rounded-lg bg-brand-red px-5 py-3 text-xs font-black uppercase text-white shadow-lg shadow-red-600/20 transition hover:scale-[1.02] hover:bg-red-700 focus:scale-[1.02] focus:outline-none focus:ring-2 focus:ring-red-500 focus:ring-offset-2"
    >
      Llamar ahora
      <span class="hidden border-l border-white/40 pl-3 text-sm normal-case tracking-normal lg:inline">
        {BUSINESS.phoneDisplay}
      </span>
    </a>
  </div>
</header>
