---
import { BUSINESS, telLink, hoursText } from '@config/business';
---

<footer class="w-full max-w-full overflow-x-hidden border-t border-gray-100 bg-white px-4 text-center sm:px-6 md:px-8 md:text-left">
  <div class="mx-auto grid max-w-7xl grid-cols-1 gap-10 py-12 md:grid-cols-4">
    <div class="flex flex-col items-center md:items-start">
      <img
        src="/assets/logotipo-cazafugas.png"
        alt="Cazafugas"
        class="h-20 w-auto object-contain"
        width="220"
        height="220"
        loading="lazy"
        decoding="async"
      />
      <p class="mt-5 max-w-xs font-sans text-sm leading-relaxed text-gray-600">
        Especialistas en detección de filtraciones con tecnología de elite.
      </p>
    </div>

    <div>
      <h3 class="font-sans text-xs font-black uppercase tracking-[0.14em] text-brand-blue">Cobertura</h3>
      <ul class="mt-5 space-y-3 font-sans text-sm text-gray-600">
        {BUSINESS.communes.map((item) => <li>{item}</li>)}
      </ul>
    </div>

    <div>
      <h3 class="font-sans text-xs font-black uppercase tracking-[0.14em] text-brand-blue">Servicios</h3>
      <ul class="mt-5 space-y-3 font-sans text-sm text-gray-600">
        <li>Detección de fugas</li>
        <li>Gasfitería autorizada</li>
        <li>Certificación SEC</li>
      </ul>
    </div>

    <div>
      <h3 class="font-sans text-xs font-black uppercase tracking-[0.14em] text-brand-blue">Contacto</h3>
      <a
        href={telLink()}
        class="mt-5 inline-flex font-sans text-base font-black text-brand-blue transition hover:text-brand-cyan"
      >
        {BUSINESS.phoneDisplay}
      </a>
      <p class="mt-4 font-sans text-sm font-semibold leading-relaxed text-gray-700">
        {hoursText()}
      </p>
      <p class="mt-1 font-sans text-sm leading-relaxed text-gray-600">
        Atención técnica en horario diurno.
      </p>
    </div>
  </div>

  <div class="mx-auto flex max-w-7xl flex-col items-center justify-between gap-4 border-t border-gray-100 py-6 font-sans text-xs leading-relaxed text-gray-500 md:flex-row">
    <p>© 2026 CAZAFUGAS. Todos los derechos reservados.</p>
    <p>
      Esta página fue diseñada por:
      <a
        href="https://espiritudigital.cl"
        target="_blank"
        rel="noopener noreferrer"
        class="font-bold text-blue-900 transition hover:text-fuchsia-500"
      >
        Espíritu Digital
      </a>
    </p>
  </div>
</footer>
