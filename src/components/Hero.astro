---
import { Image } from 'astro:assets';
import AfterHoursNotice from '@components/AfterHoursNotice.astro';
import { BUSINESS, communesText, telLink, waLink } from '@config/business';

// TODO(confirmar): foto real de Don Hernán trabajando (PLAN-MAESTRO 2.2). Cuando llegue,
// guardarla en src/assets/ e importarla aquí; mientras tanto se muestra solo el sello SEC.
const heroPhoto: ImageMetadata | null = null;

const heroImages = [
  '/images/carrusel-1.webp',
  '/images/carrusel-2.webp',
  '/images/carrusel-3.webp'
];
---

<section id="inicio" class="relative min-h-screen w-full max-w-full overflow-x-hidden overflow-y-hidden text-white">
  <div class="absolute inset-0 z-0" aria-hidden="true">
    {
      heroImages.map((image, index) => (
        <picture
          class={`hero-bg-slide absolute inset-0 h-full w-full transition-opacity duration-1000 ease-in-out ${
            index === 0 ? 'opacity-100' : 'opacity-0'
          }`}
          data-hero-slide
        >
          <source srcset={image} type="image/webp" />
          <img
            src={image}
            alt=""
            class="h-full w-full object-cover"
            loading={index === 0 ? 'eager' : 'lazy'}
            decoding="async"
            fetchpriority={index === 0 ? 'high' : undefined}
          />
        </picture>
      ))
    }
    <div class="absolute inset-0 bg-black/60"></div>
  </div>

  <div class="relative z-10 mx-auto grid min-h-screen w-full max-w-7xl grid-cols-1 items-start gap-8 px-4 pb-10 md:items-center pt-[calc(var(--header-height)+1.5rem)] text-center sm:px-6 md:grid-cols-[1.618fr_1fr] md:gap-fib-5 md:px-8 md:pb-0 md:pt-[var(--header-height)] md:text-left">
    <div class="flex flex-col items-center md:items-start">
      <img
        src="/assets/certificacion-sec-title.png"
        alt="Personal certificado SEC"
        class="image-high-quality mb-4 h-20 max-w-full transform-gpu rounded-full border border-white/20 p-1.5 object-contain antialiased drop-shadow-lg sm:mb-6 sm:h-28 md:hidden"
        loading="eager"
        decoding="async"
      />

      <p class="mb-4 max-w-full text-xs font-black uppercase leading-relaxed tracking-[0.14em] text-cyan-100 sm:mb-5 sm:tracking-[0.18em]">
        👉 Tu tranquilidad, nuestra garantía.
      </p>

      <h1 class="text-shadow-md max-w-full font-heading text-h1 font-extrabold tracking-tight text-white md:max-w-3xl">
        Detección de Fugas y Gasfitería Autorizada
      </h1>

      <p class="mt-5 max-w-full text-lead font-medium text-gray-200 sm:mt-6 md:max-w-2xl">
        Excelencia técnica en mantención de calefones y detección de fugas. Intervenciones seguras y certificadas por la SEC.
        Atendemos en {communesText()}.
      </p>

      <AfterHoursNotice />

      <div class="mt-6 flex w-full max-w-full flex-col gap-3 sm:w-auto sm:flex-row sm:gap-4">
        <a
          href={waLink()}
          data-cta="hero"
          target="_blank"
          rel="noopener"
          class="inline-flex min-h-14 w-full animate-soft-pulse items-center justify-center gap-3 rounded-lg bg-gradient-to-r from-green-500 to-emerald-600 px-6 py-4 font-sans text-sm font-black uppercase text-white shadow-lg shadow-emerald-500/30 transition hover:scale-[1.02] hover:from-green-400 hover:to-emerald-500 focus:outline-none focus:ring-2 focus:ring-emerald-200 focus:ring-offset-2 focus:ring-offset-slate-950 sm:w-auto sm:px-8"
        >
          <span aria-hidden="true">▣</span>
          Urgencia WhatsApp
        </a>

        <a
          href={telLink()}
          data-cta="hero"
          class="order-first inline-flex min-h-14 w-full items-center justify-center rounded-lg border border-white/70 bg-white/10 px-6 py-4 font-sans text-sm font-black uppercase text-white shadow-lg shadow-black/20 backdrop-blur-md transition hover:bg-white hover:text-slate-950 focus:outline-none focus:ring-2 focus:ring-white focus:ring-offset-2 focus:ring-offset-slate-950 sm:w-auto sm:px-8 md:order-none"
        >
          Llamar ahora
        </a>
      </div>

      <p class="mt-4 text-sm font-bold text-emerald-100">
        <span aria-hidden="true">✓</span> Pagas al terminar. Sin anticipos.
      </p>
    </div>

    <div class="hidden max-w-full items-center justify-center md:flex">
      {
        heroPhoto ? (
          <div class="relative w-full max-w-sm">
            <Image
              src={heroPhoto}
              alt={`${BUSINESS.name} trabajando`}
              class="aspect-[4/5] w-full rounded-3xl border border-white/20 object-cover shadow-2xl shadow-black/40"
              width={768}
              format="webp"
              loading="lazy"
            />
            <img
              src="/assets/certificacion-sec-title.png"
              alt="Personal certificado SEC"
              class="absolute -bottom-fib-4 -left-fib-4 h-32 w-32 rounded-full border border-white/30 bg-white/90 p-1 object-contain shadow-xl"
              loading="lazy"
              decoding="async"
            />
          </div>
        ) : (
          <img
            src="/assets/certificacion-sec-title.png"
            alt="Personal certificado SEC"
            class="image-high-quality h-56 max-w-full transform-gpu rounded-full border border-white/20 p-2 object-contain antialiased drop-shadow-lg lg:h-[15.6rem]"
            loading="lazy"
            decoding="async"
          />
        )
      }
    </div>
  </div>
</section>

<style>
  .hero-bg-slide {
    will-change: opacity;
  }
</style>

<script is:inline>
  const heroSlides = Array.from(document.querySelectorAll('[data-hero-slide]'));
  let activeHeroSlide = 0;

  if (heroSlides.length > 1) {
    setInterval(() => {
      heroSlides[activeHeroSlide].classList.remove('opacity-100');
      heroSlides[activeHeroSlide].classList.add('opacity-0');

      activeHeroSlide = (activeHeroSlide + 1) % heroSlides.length;

      heroSlides[activeHeroSlide].classList.remove('opacity-0');
      heroSlides[activeHeroSlide].classList.add('opacity-100');
    }, 5000);
  }
</script>
