---
const heroImages = [
  '/images/carrusel-1.webp',
  '/images/carrusel-2.webp',
  '/images/carrusel-3.webp'
];
---

<section id="inicio" class="relative min-h-screen w-full max-w-full overflow-x-hidden overflow-y-hidden text-white">
  <div class="absolute inset-0 z-0" aria-hidden="true">
    {
      heroImages.map((image, index) => (
        <picture
          class={`hero-bg-slide absolute inset-0 h-full w-full transition-opacity duration-1000 ease-in-out ${
            index === 0 ? 'opacity-100' : 'opacity-0'
          }`}
          data-hero-slide
        >
          <source srcset={image} type="image/webp" />
          <img
            src={image}
            alt=""
            class="h-full w-full object-cover"
            loading="eager"
            decoding="async"
            fetchpriority="high"
          />
        </picture>
      ))
    }
    <div class="absolute inset-0 bg-black/60"></div>
  </div>

  <div class="relative z-10 mx-auto grid min-h-screen w-full max-w-7xl grid-cols-1 items-center gap-8 px-4 pb-10 pt-[calc(var(--header-height)+1.5rem)] text-center sm:px-6 md:grid-cols-2 md:gap-10 md:px-8 md:pb-0 md:pt-[var(--header-height)] md:text-left">
    <div class="flex flex-col items-center md:items-start">
      <img
        data-reveal
        src="/assets/certificacion-sec-title.png"
        alt="SEC"
        class="image-high-quality mb-6 h-28 max-w-full transform-gpu rounded-full border border-white/20 p-2 object-contain antialiased drop-shadow-lg sm:h-[9.1rem] md:hidden"
        loading="eager"
        decoding="async"
        fetchpriority="high"
      />

      <p data-reveal class="mb-4 max-w-full text-xs font-black uppercase leading-relaxed tracking-[0.14em] text-cyan-100 sm:mb-5 sm:tracking-[0.18em]">
        👉 Tu tranquilidad, nuestra garantía.
      </p>

      <h1 data-reveal class="text-shadow-md max-w-full font-heading text-4xl font-extrabold leading-tight tracking-tight text-white sm:text-5xl md:max-w-3xl md:text-7xl">
        Detección de Fugas y Gasfitería Autorizada
      </h1>

      <p data-reveal class="mt-5 max-w-full text-base font-medium leading-relaxed text-gray-200 sm:mt-6 md:max-w-2xl md:text-xl">
        Excelencia técnica en mantención de calefones y detección de fugas. Intervenciones seguras y certificadas por la SEC.
      </p>

      <div data-reveal class="mt-8 flex w-full max-w-full flex-col gap-3 sm:mt-10 sm:w-auto sm:flex-row sm:gap-4">
        <a
          href="#contacto"
          class="inline-flex min-h-14 w-full animate-soft-pulse items-center justify-center gap-3 rounded-lg bg-gradient-to-r from-green-500 to-emerald-600 px-6 py-4 font-sans text-sm font-black uppercase text-white shadow-lg shadow-emerald-500/30 transition hover:scale-[1.02] hover:from-green-400 hover:to-emerald-500 focus:outline-none focus:ring-2 focus:ring-emerald-200 focus:ring-offset-2 focus:ring-offset-slate-950 sm:w-auto sm:px-8"
        >
          <span aria-hidden="true">▣</span>
          Urgencia WhatsApp
        </a>

        <a
          href="#contacto"
          class="inline-flex min-h-14 w-full items-center justify-center rounded-lg border border-white/70 bg-white/10 px-6 py-4 font-sans text-sm font-black uppercase text-white shadow-lg shadow-black/20 backdrop-blur-md transition hover:bg-white hover:text-slate-950 focus:outline-none focus:ring-2 focus:ring-white focus:ring-offset-2 focus:ring-offset-slate-950 sm:w-auto sm:px-8"
        >
          Asesoría técnica
        </a>
      </div>
    </div>

    <div class="hidden max-w-full items-center justify-center md:flex">
      <img
        data-reveal
        src="/assets/certificacion-sec-title.png"
        alt="SEC"
        class="image-high-quality h-56 max-w-full transform-gpu rounded-full border border-white/20 p-2 object-contain antialiased drop-shadow-lg lg:h-[15.6rem]"
        loading="eager"
        decoding="async"
        fetchpriority="high"
      />
    </div>
  </div>
</section>

<style>
  .hero-bg-slide {
    will-change: opacity;
  }
</style>

<script is:inline>
  const heroSlides = Array.from(document.querySelectorAll('[data-hero-slide]'));
  let activeHeroSlide = 0;

  if (heroSlides.length > 1) {
    setInterval(() => {
      heroSlides[activeHeroSlide].classList.remove('opacity-100');
      heroSlides[activeHeroSlide].classList.add('opacity-0');

      activeHeroSlide = (activeHeroSlide + 1) % heroSlides.length;

      heroSlides[activeHeroSlide].classList.remove('opacity-0');
      heroSlides[activeHeroSlide].classList.add('opacity-100');
    }, 5000);
  }
</script>
