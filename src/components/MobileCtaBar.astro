---
// Barra fija de contacto: solo bajo 768 px. El <body> reserva su alto en global.css.
import { telLink, waLink } from '@config/business';
---

<nav
  aria-label="Contacto rápido"
  class="mobile-cta-bar fixed inset-x-0 bottom-0 z-[60] grid grid-cols-2 bg-slate-950 shadow-[0_-8px_24px_rgba(0,0,0,0.18)] md:hidden"
>
  <a
    href={telLink()}
    data-cta="barra_movil"
    class="flex h-14 items-center justify-center gap-2 bg-brand-red font-sans text-base font-black uppercase text-white active:bg-red-700"
  >
    <svg aria-hidden="true" class="size-5" viewBox="0 0 24 24" fill="none">
      <path
        d="M5 4h4l2 5-2.5 1.5a11 11 0 0 0 5 5L15 13l5 2v4a2 2 0 0 1-2 2A16 16 0 0 1 3 6a2 2 0 0 1 2-2"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"></path>
    </svg>
    Llamar
  </a>
  <a
    href={waLink()}
    data-cta="barra_movil"
    target="_blank"
    rel="noopener"
    class="flex h-14 items-center justify-center gap-2 bg-green-700 font-sans text-base font-black uppercase text-white active:bg-green-800"
  >
    <svg aria-hidden="true" class="size-5" viewBox="0 0 24 24" fill="none">
      <path
        d="M21 11.5a8.4 8.4 0 0 1-12.4 7.4L3 20.5l1.6-5.4A8.4 8.4 0 1 1 21 11.5Z"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"></path>
    </svg>
    WhatsApp
  </a>
</nav>
