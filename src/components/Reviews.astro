---
// Reseñas reales (PLAN-MAESTRO 3.3). No se muestra nada mientras REVIEWS esté vacío.
import { REVIEWS, REVIEWS_URL } from '../data/reviews';

const dateFormat = new Intl.DateTimeFormat('es-CL', { month: 'long', year: 'numeric', timeZone: 'America/Santiago' });
---

{
  REVIEWS.length > 0 && (
    <section id="resenas" class="w-full max-w-full overflow-x-hidden bg-white px-4 py-section sm:px-6 md:px-8">
      <div class="mx-auto max-w-6xl">
        <h2 data-reveal class="text-center font-heading text-h2 font-extrabold text-brand-navy">
          Lo que dicen nuestros clientes
        </h2>
        <ul class="mt-fib-4 grid grid-cols-1 gap-fib-3 md:grid-cols-3">
          {REVIEWS.map((review) => (
            <li data-reveal class="flex flex-col rounded-2xl border border-slate-200 bg-brand-surface p-fib-3">
              <p class="text-amber-500" aria-label={`${review.rating} de 5 estrellas`}>
                {'★'.repeat(review.rating)}
                <span class="text-slate-300">{'★'.repeat(5 - review.rating)}</span>
              </p>
              <blockquote class="mt-fib-2 flex-1 text-body text-slate-700">“{review.text}”</blockquote>
              <p class="mt-fib-2 text-sm font-semibold text-slate-900">
                {review.author}
                {review.commune && <span class="font-normal text-slate-500"> · {review.commune}</span>}
              </p>
              <p class="text-xs text-slate-500">
                Reseña en Google · {dateFormat.format(new Date(`${review.date}T12:00:00`))}
              </p>
            </li>
          ))}
        </ul>
        {REVIEWS_URL && (
          <p class="mt-fib-4 text-center">
            <a href={REVIEWS_URL} target="_blank" rel="noopener" class="font-semibold text-blue-800 underline underline-offset-4">
              Ver todas las reseñas en Google
            </a>
          </p>
        )}
      </div>
    </section>
  )
}
