---
// "Cómo trabajamos" en 3 pasos (PLAN-MAESTRO 2.4). Los textos usan solo datos ya confirmados.
import { BUSINESS } from '@config/business';

const openHour = Number(BUSINESS.hours.open.slice(0, 2));
const closeHour = Number(BUSINESS.hours.close.slice(0, 2));

const steps = [
  {
    title: 'Escribes o llamas',
    text: `Cuéntanos qué pasa por WhatsApp o por teléfono, ${BUSINESS.hours.days.toLowerCase()} de ${openHour} a ${closeHour}.`
  },
  {
    title: 'Diagnosticamos sin romper',
    text: 'Usamos ultrasonido, presión controlada y termografía para ubicar la fuga antes de intervenir.'
  },
  {
    title: 'Pagas al terminar',
    text: 'Sin anticipos. Pagas en efectivo, transferencia o tarjeta cuando el trabajo está listo.'
  }
];
---

<section id="como-trabajamos" class="w-full max-w-full overflow-x-hidden bg-white px-4 py-section sm:px-6 md:px-8">
  <div class="mx-auto max-w-6xl">
    <div data-reveal class="mx-auto max-w-2xl text-center">
      <p class="font-sans text-xs font-black uppercase tracking-[0.18em] text-blue-700">Paso a paso</p>
      <h2 class="mt-fib-2 font-heading text-h2 font-extrabold text-brand-navy">Cómo trabajamos</h2>
    </div>

    <ol class="mt-fib-5 grid grid-cols-1 gap-fib-3 md:grid-cols-3 md:gap-fib-4">
      {
        steps.map((step, index) => (
          <li data-reveal class="relative rounded-3xl border border-slate-200 bg-brand-surface p-fib-4 shadow-ambient">
            <span
              class="flex size-fib-5 items-center justify-center rounded-full bg-brand-navy font-heading text-h3 font-extrabold text-white"
              aria-hidden="true"
            >
              {index + 1}
            </span>
            <h3 class="mt-fib-3 font-heading text-h3 font-extrabold text-brand-navy">{step.title}</h3>
            <p class="mt-fib-2 font-sans text-body text-slate-600">{step.text}</p>
          </li>
        ))
      }
    </ol>
  </div>
</section>
