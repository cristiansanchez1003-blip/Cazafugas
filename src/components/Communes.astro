---
// Comunas atendidas (PLAN-MAESTRO 2.5). Destino del enlace "Comunas" del menú.
import { BUSINESS } from '@config/business';
---

<section id="comunas" class="w-full max-w-full overflow-x-hidden bg-brand-navy px-4 py-section text-white sm:px-6 md:px-8">
  <div data-reveal class="mx-auto max-w-5xl text-center">
    <p class="font-sans text-xs font-black uppercase tracking-[0.18em] text-cyan-200">Cobertura</p>
    <h2 class="mt-fib-2 font-heading text-h2 font-extrabold">Comunas donde atendemos</h2>
    <p class="mx-auto mt-fib-3 max-w-xl font-sans text-body text-blue-100">Nuestras comunas principales:</p>
    <ul class="mt-fib-4 flex flex-wrap justify-center gap-fib-2">
      {
        BUSINESS.communes.map((commune) => (
          <li class="rounded-full border border-white/25 bg-white/10 px-fib-3 py-fib-2 font-sans text-body font-bold">
            {commune}
          </li>
        ))
      }
    </ul>
    <p class="mx-auto mt-fib-4 max-w-xl font-sans text-body font-semibold text-white">
      {BUSINESS.extendedCoverage}
    </p>
    <p class="mx-auto mt-fib-3 max-w-xl font-sans text-body text-blue-100">
      {BUSINESS.hours.days} de {BUSINESS.hours.open} a {BUSINESS.hours.close} hrs. Sin trabajos nocturnos.
    </p>
  </div>
</section>
